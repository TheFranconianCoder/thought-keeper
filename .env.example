# Thought Keeper — development environment.
# Copy to .env. Real environment variables always win over this file, and the file
# is only a development convenience (it is gitignored).

# The agent needs this to atomize sources.
OPENAI_API_KEY=

# OpenAI-compatible endpoint (leave empty for OpenAI itself).
# OPENAI_BASE_URL=

# Model that the endpoint actually serves (opencode Zen does not serve gpt-4o-mini).
# List them with: thought-keeper models
# OPENAI_MODEL=deepseek-v4.1-flash          # sets BOTH phases
# OPENAI_MODEL_COMPILE=claude-haiku-5-5     # overrides only the mechanical phases (trees,
#                                           # atoms, compile) — a non-reasoning model is faster
# OPENAI_MODEL_REASON=deepseek-v4.1-flash   # overrides only queries and lint

# How much a thinking model may deliberate ("minimal" | "low" | "medium" | "high").
# Thinking tokens ARE wall-clock time in the mechanical phases; the defaults are minimal.
# OPENAI_REASONING_EFFORT_COMPILE=
# OPENAI_REASONING_EFFORT_REASON=
# Deciding what ONE claim is (atomize) is the only judgement call in the mechanical phases —
# the one knob worth raising. Judge it in the source log: `passes=2`, how many claims the
# audit still had to add, and the tokens/seconds per part.
# OPENAI_REASONING_EFFORT_ATOMIZE=low

# How patient the caller is with the endpoint. A transient failure (timeout, 429, 5xx) is
# retried with a doubling backoff; the whole retry ladder is capped by the timeout itself, so
# one call can never wait for hours.
# OPENAI_TIMEOUT=120s
# OPENAI_RETRIES=2
# OPENAI_RETRY_BACKOFF=2s

# Where the CLI finds the running instance (default: from the runtime file).
# THOUGHT_KEEPER_URL=127.0.0.1:9210
