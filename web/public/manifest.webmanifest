{
    "id": "/",
    "name": "Thought Keeper",
    "short_name": "Thought Keeper",
    "description": "A local, agentic knowledge base.",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
